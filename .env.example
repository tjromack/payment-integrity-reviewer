# Copy to .env and fill in. Detection runs with NO external calls;
# the key is only needed for the LLM explanation layer (app/explain.py).
ANTHROPIC_API_KEY=

# Model + prompt version are recorded with each explanation (see EVAL.md).
# Override to a cheaper model (e.g. claude-sonnet-4-6) for high-volume runs.
ANTHROPIC_MODEL=claude-opus-4-8
